<file path="src/utils/array-utils.ts">
export const range = (lo: number, hi: number): number[] => {
  const result = Array<number>(hi - lo);
  for (let i = lo; i < hi; i++) {
    result[i - lo] = i;
  }
  return result;
};

export const sum = (numbers: number[]): number => {
  let total = 0;
  for (const number of numbers) {
    total += number;
  }
  return total;
};
</file>

<file path="src/utils/dateString.ts">
import type dayjs from "dayjs";

const DATE_STRING_FORMAT = "YYYY-MM-DD";

export type DateString =
  `${number}${number}${number}${number}-${number}${number}-${number}${number}`;

export const toDateString = (day: dayjs.Dayjs): DateString => {
  return day.format(DATE_STRING_FORMAT) as DateString;
};
</file>

